# Production environment for docker-compose.prod.yml.
# Copy to deploy/.env and fill in real values, then:
#   docker compose --env-file deploy/.env \
#     -f deploy/docker-compose.yml -f deploy/docker-compose.prod.yml \
#     --profile app up --build -d

# Database password (used by Postgres and inside POSTGRES_DSN below).
POSTGRES_PASSWORD=ganti-password-kuat

# Full DSN the app services connect with (host = compose service name).
POSTGRES_DSN=postgres://postgres:ganti-password-kuat@postgres:5432/billing_radius?sslmode=disable

# Redis address (compose service name).
REDIS_ADDR=redis:6379

# WAJIB di production: minimal 32 karakter, acak.
#   contoh generate: openssl rand -base64 48
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter

# Komisi reseller (basis points; 500 = 5%).
COMMISSION_RATE_BPS=500

# GenieACS NBI (kosongkan bila tidak pakai ACS).
ACS_BASE_URL=

# Logging.
LOG_LEVEL=info
LOG_FORMAT=json
