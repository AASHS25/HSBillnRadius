# Copy to .env for local development: `cp configs/.env.example .env`
# Values here match deploy/docker-compose.yml dev infra.

# --- App ---
APP_NAME=billing-radius
APP_ENV=development           # development | staging | production
LOG_LEVEL=info                # debug | info | warn | error
LOG_FORMAT=json               # json | text

# --- HTTP (api-service) ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=20s
HTTP_REQUEST_TIMEOUT=30s

# --- PostgreSQL ---
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/billing_radius?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2
POSTGRES_MAX_CONN_LIFETIME=1h
POSTGRES_MAX_CONN_IDLE_TIME=30m
POSTGRES_CONNECT_TIMEOUT=5s

# --- Redis ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_DIAL_TIMEOUT=5s

# --- RADIUS (radius-service) ---
RADIUS_AUTH_ADDR=0.0.0.0:1812
RADIUS_ACCT_ADDR=0.0.0.0:1813
RADIUS_COA_PORT=3799
